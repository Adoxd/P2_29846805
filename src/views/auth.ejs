<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <title>Autenticación</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/auth.css">
  <script src="js/alertConfig.js"></script>
  <style>
    .google-btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 15px;
      background: white;
      color: #444;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
    }

    .google-btn img {
      width: 20px;
      margin-right: 10px;
    }
  </style>
</head>
<body>
    <nav class="navbar" style="position: relative;">
  <div class="container">
    <a href="/" class="logo">TechFix</a>
    <div class="nav-links">
      <a href="/admin/contacts"><%= __('Contacto') %></a>
      <a href="/getPayment"><%= __('Pagos') %></a>
    </div>
  </div>
</nav>

<div class="flex justify-center gap-4 mb-6">
  <a href="/getPayment?lang=es" class="inline-flex items-center px-4 py-2 rounded-lg bg-white text-gray-700 border border-gray-300 shadow-sm hover:bg-blue-100 hover:text-blue-700 transition-colors duration-200">
    🇪🇸 <span class="ml-2">Español</span>
  </a>
  <a href="/getPayment?lang=en" class="inline-flex items-center px-4 py-2 rounded-lg bg-white text-gray-700 border border-gray-300 shadow-sm hover:bg-blue-100 hover:text-blue-700 transition-colors duration-200">
    🇺🇸 <span class="ml-2">English</span>
  </a>
</div>


<div class="auth-container">
  <div class="auth-switcher">
    <button 
      class="auth-btn <%= formType === 'login' ? 'active' : '' %>" 
      onclick="switchForm('login')">
      <%= __('auth.loginTab') %>
    </button>
    <button 
      class="auth-btn <%= formType === 'register' ? 'active' : '' %>" 
      onclick="switchForm('register')">
      <%= __('auth.registerTab') %>
    </button>
  </div>

  <% if (formType === 'login') { %>
  <form id="formLogin" class="auth-form">
    <h2><%= __('auth.loginTab') %></h2>

    <div class="form-group">
      <label for="login-email"><%= __('auth.email') %></label>
      <input 
        type="email" 
        id="login-email" 
        name="email" 
        required
        placeholder="<%= __('auth.emailPlaceholder') %>">
    </div>

    <div class="form-group">
      <label for="login-password"><%= __('auth.password') %></label>
      <input 
        type="password" 
        id="login-password" 
        name="password" 
        required
        placeholder="<%= __('auth.passwordPlaceholder') %>">
    </div>

    <a href="/auth/google" class="bg-red-500 text-white px-4 py-2 rounded">
      <%= __('auth.orContinueWith') %> Google
    </a>

    <button type="submit" class="submit-btn"><%= __('auth.loginButton') %></button>
  </form>

  <% } else { %>
  <form id="formRegister" class="auth-form">
    <h2><%= __('auth.createAccount') %></h2>

    <div class="form-group">
      <label for="register-name"><%= __('auth.fullName') %></label>
      <input 
        type="text" 
        id="username" 
        name="username" 
        required
        placeholder="<%= __('auth.namePlaceholder') %>">
    </div>

    <div class="form-group">
      <label for="register-email"><%= __('auth.email') %></label>
      <input 
        type="email" 
        id="register-email" 
        name="email" 
        required
        placeholder="<%= __('auth.emailPlaceholder') %>">
    </div>

    <div class="form-group">
      <label for="register-password"><%= __('auth.password') %></label>
      <input 
        type="password" 
        id="register-password" 
        name="password_hash" 
        required
        placeholder="<%= __('auth.passwordPlaceholder') %>"
        minlength="6">
    </div>

    <div class="form-group">
      <label for="register-confirm"><%= __('auth.confirmPassword') %></label>
      <input 
        type="password" 
        id="register-confirm" 
        name="passwordHash" 
        required
        placeholder="<%= __('auth.passwordPlaceholder') %>">
    </div>

    <button type="submit" class="submit-btn"><%= __('auth.registerButton') %></button>
  </form>
  <% } %>
</div>


<script>
  function switchForm(type) {
    window.location.href = `/login?form=${type}`;
  }
</script>
<script>
  let data,formData
  const formRegister = document.querySelector('#formRegister');
  if (formRegister) {
    formRegister.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/registerUser', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        Swal.fire(res.message);
      });
    });
  }
</script>

<script>
  const formLogin = document.querySelector('#formLogin');
  if (formLogin) {
    formLogin.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/loginPost', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        if (res.status) {
          Swal.fire(res.message).then(() => {
            window.location.href = '/admin/contacts';
          });
        } else {
          Swal.fire(res.message);
        }
      });
    });
  }
</script>
</body>
</html>